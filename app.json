{
  "expo": {
    "name": "PostaRindo",
    "slug": "postarindo",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon-no-text.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sollar.postarindo"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.sollar.postarindo"
    },
    "transpilePackages": [
      "@react-native-picker/picker",
      "@supabase/supabase-js"
    ],
    "plugins": [
      "expo-secure-store",
      "expo-router",
      "expo-localization"
    ],
    "scheme": "postarindo"
  }
}
